{
  "name": "Tab Trainer — Guitar Pro practice",
  "short_name": "Tab Trainer",
  "description": "Read Guitar Pro files as notation and tab, and practice with playback, loops and a live fretboard.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#121418",
  "theme_color": "#181b20",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/octet-stream": [".gp", ".gpx", ".gp3", ".gp4", ".gp5"] } }
  ]
}
